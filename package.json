{
	"name": "@mikode13/git-hooks",
	"version": "0.1.0",
	"description": "Shared Git hooks, Conventional Commit validation, and workflow tooling for MiKode repositories.",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mikode13/git-hooks.git"
	},
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"packageManager": "pnpm@11.17.0",
	"bin": {
		"mikode-git-hooks": "./bin/mikode-git-hooks.mjs"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"bin",
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "node scripts/verify-pnpm.mjs && node bin/mikode-git-hooks.mjs install",
		"prepack": "pnpm run build",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit && node --check bin/mikode-git-hooks.mjs && node --check scripts/verify-pnpm.mjs && node --check eslint.config.js && node --check prettier.config.mjs",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"test": "tsx --test test/*.test.ts",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
		"audit:prod": "pnpm audit --prod",
		"pack:check": "pnpm pack --dry-run"
	},
	"keywords": [
		"commitlint",
		"conventional-commits",
		"git-hooks",
		"husky"
	],
	"dependencies": {
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/lint": "21.2.0",
		"@commitlint/load": "21.2.0",
		"husky": "9.1.7"
	},
	"devDependencies": {
		"@mikode13/code-quality": "0.1.0",
		"@mikode13/code-style": "0.1.0",
		"@mikode13/tsconfig": "0.1.0",
		"@types/node": "24.13.3",
		"eslint": "10.8.0",
		"prettier": "3.9.6",
		"tsx": "4.23.1",
		"typescript": "6.0.3"
	}
}
