{
	"name": "@mikode13/git-hooks",
	"version": "0.0.0-development",
	"description": "Shared Git hooks, Conventional Commit validation, and workflow tooling for MiKode repositories.",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mikode13/git-hooks.git"
	},
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"packageManager": "pnpm@11.17.0",
	"bin": {
		"mikode-git-hooks": "./bin/mikode-git-hooks.mjs"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"bin",
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "node bin/mikode-git-hooks.mjs install",
		"prepack": "pnpm run build",
		"build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests && node --check bin/mikode-git-hooks.mjs && node --check eslint.config.js && node --check prettier.config.mjs",
		"test": "pnpm run test:unit",
		"test:unit": "vitest run --project unit",
		"test:unit:watch": "vitest --project unit",
		"test:coverage": "vitest run --coverage",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
		"audit:prod": "pnpm audit --prod",
		"pack:check": "pnpm run build && node scripts/pack-check.mjs"
	},
	"keywords": [
		"commitlint",
		"conventional-commits",
		"git-hooks",
		"husky"
	],
	"dependencies": {
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/lint": "21.2.0",
		"@commitlint/load": "21.2.0",
		"husky": "9.1.7"
	},
	"devDependencies": {
		"@mikode13/code-quality": "0.1.0",
		"@mikode13/code-style": "0.1.0",
		"@mikode13/tsconfig": "0.1.0",
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.10",
		"eslint": "10.8.0",
		"prettier": "3.9.6",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
